{
  "name": "life-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "check": "tsc -b && vitest run && vite build",
    "db:bundle": "node scripts/db-bundle.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "csp:serve": "node scripts/serve-with-headers.mjs dist 4173",
    "csp:probe": "node scripts/csp-probe.mjs",
    "test:e2e:ci": "PW_CHANNEL= playwright test --project=phone tests/e2e/smoke.spec.ts tests/e2e/today.spec.ts tests/e2e/habits-tasks.spec.ts tests/e2e/rejections-journal-books.spec.ts tests/e2e/gym.flows.spec.ts tests/e2e/entertainment-rewards-settings.spec.ts",
    "test:e2e-sync": "playwright test -c tests/e2e-sync/playwright.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.169.0",
    "vite-plugin-pwa": "^0.20.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@electric-sql/pglite": "^0.2.15",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "pg": "^8.23.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
